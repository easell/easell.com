---
// 基础布局：中文站 SEO（百度友好）——标题/描述/canonical/JSON-LD/面包屑
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

interface Crumb { name: string; url: string; }

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, any> | Record<string, any>[];
  breadcrumbs?: Crumb[];
  active?: string;
  preloadImage?: string;
  /** og:type —— 内容型页面（动态详情/文章）用 article，其余保持 website */
  ogType?: 'website' | 'article';
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  image = '/img/og-image.jpg',
  noindex = false,
  jsonLd,
  breadcrumbs,
  active,
  preloadImage,
  ogType = 'website',
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonicalAbs = new URL(canonical, site).href;
const ogImage = new URL(image, site).href;

const autoCrumbs: Crumb[] =
  breadcrumbs ??
  (Astro.url.pathname === '/'
    ? []
    : [
        { name: '首页', url: '/' },
        { name: title.split('｜')[0].trim(), url: Astro.url.pathname },
      ]);

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.legalName,
  url: site.href,
  logo: new URL('/img/logo.png', site).href,
  description: SITE.shortDesc,
  foundingDate: '2022-09-01',
  address: {
    '@type': 'PostalAddress',
    streetAddress: '学士街道学华村碧桂园（智慧园）30 栋 102',
    addressLocality: '长沙市',
    addressRegion: '湖南省',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+86-731-88766800',
    contactType: 'customer service',
    areaServed: 'CN',
    availableLanguage: ['zh-CN'],
  },
  parentOrganization: { '@type': 'Organization', name: '御豪集团', url: SITE.groupUrl },
  areaServed: { '@type': 'AdministrativeArea', name: '湖南省' },
  knowsAbout: [
    '全生物降解塑料制品',
    '一次性可降解餐饮具',
    '可降解塑料制品备案与溯源',
    '禁塑限塑政策合规采购',
    '集采集供',
  ],
  identifier: {
    '@type': 'PropertyValue',
    name: '统一社会信用代码',
    value: SITE.uscc,
  },
  sameAs: [SITE.groupUrl],
};

// 品牌实体：利于「易采通」品牌词检索与知识面板
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: ['易采通云超市', '湖南省集采集供平台', SITE.legalName],
  url: site.href,
  inLanguage: 'zh-CN',
  publisher: { '@type': 'Organization', name: SITE.legalName, url: site.href },
};

const crumbLd = autoCrumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: autoCrumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: c.name,
        item: new URL(c.url, site).href,
      })),
    }
  : null;

const pageLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const allLd = [orgLd, websiteLd, ...(crumbLd ? [crumbLd] : []), ...pageLd];
---
<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="applicable-device" content="pc,mobile" />
    <!-- 双核浏览器优先极速内核（百度推荐），避免国产浏览器用兼容内核渲染 -->
    <meta name="renderer" content="webkit" />
    <meta name="force-rendering" content="webkit" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalAbs} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#f57921" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${SITE.name}｜${SITE.tagline}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalAbs} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}｜${SITE.tagline}`} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}
    {allLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
  </head>
  <body>
    <a href="#main" class="skip">跳到正文</a>
    <SiteHeader active={active} />
    <main id="main">
      {autoCrumbs.length > 0 && (
        <nav class="crumbs" aria-label="面包屑">
          <div class="container">
            {autoCrumbs.map((c, i) => (
              <>
                {i > 0 && ' › '}
                {i === autoCrumbs.length - 1 ? <span>{c.name}</span> : <a href={c.url}>{c.name}</a>}
              </>
            ))}
          </div>
        </nav>
      )}
      <slot />
    </main>
    <SiteFooter />
    <script>
      // 询盘溯源：全站记录浏览轨迹（sessionStorage，会话结束即清空）
      // InquiryForm 提交时读取 esTrail / esRef 一并送出，服务端拼进企微消息。
      (() => {
        try {
          const KEY = 'esTrail';
          const p = (location.pathname.replace(/\/index\.html?$/, '') || '/') ;
          const list = JSON.parse(sessionStorage.getItem(KEY) || '[]');
          if (!Array.isArray(list)) throw 0;
          if (!list.length || list[list.length - 1].p !== p) list.push({ p, t: Date.now() });
          while (list.length > 15) list.shift();
          sessionStorage.setItem(KEY, JSON.stringify(list));
          // 站外来路（百度搜索、外部链接）：每个会话只记第一次进入的来源
          if (!sessionStorage.getItem('esRef') && document.referrer) {
            try {
              const host = new URL(document.referrer).hostname;
              if (!/(^|\.)easell\.com$/.test(host)) {
                sessionStorage.setItem('esRef', document.referrer);
              }
            } catch {}
          }
        } catch {}
      })();
    </script>
  </body>
</html>
