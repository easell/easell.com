---
// 在线留言表单（与 YUHAO / KYSON 同一套：POST /api/contact → Pages Function → 企微群机器人）
// 无 JS 依赖：直接表单提交，成功/失败都是服务端返回的结果页，弱网与老浏览器都能用。
import { SITE } from '../data/site';

interface Props {
  /** 锚点 id，同时作为字段 id 前缀，避免同页多表单冲突 */
  id?: string;
  /** 来意默认选中项 */
  topic?: string;
  /** 隐藏字段：来源页面，便于分派跟进 */
  page?: string;
  compact?: boolean;
}
const { id = 'inquiry', topic = '', page = Astro.url.pathname, compact = false } = Astro.props;

const TOPICS = [
  '产品采购询价',
  '政企（公共机构）采购',
  '经销合作',
  '检测报告与资质文件',
  '投诉与建议',
  '其他',
];
---
<form class:list={['inquiry-form', { compact }]} id={id} method="post" action="/api/contact">
  <input type="hidden" name="page" value={page} />

  <div class="row">
    <div class="field">
      <label for={`${id}-name`}>姓名 <span class="req">*</span></label>
      <input id={`${id}-name`} name="name" required autocomplete="name" placeholder="怎么称呼你" />
    </div>
    <div class="field">
      <label for={`${id}-org`}>单位</label>
      <input id={`${id}-org`} name="org" autocomplete="organization" placeholder="公司 / 单位名称（可选）" />
    </div>
  </div>

  <div class="row">
    <div class="field">
      <label for={`${id}-phone`}>手机 / 电话</label>
      <input id={`${id}-phone`} name="phone" inputmode="tel" autocomplete="tel" placeholder="手机号或座机" />
    </div>
    <div class="field">
      <label for={`${id}-email`}>邮箱</label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" placeholder="name@company.com" />
    </div>
  </div>
  <p class="hint">手机与邮箱至少填一项，我们按你留的方式回复。</p>

  <div class="row">
    <div class="field">
      <label for={`${id}-region`}>所在地区</label>
      <input id={`${id}-region`} name="region" placeholder="如：长沙市岳麓区" />
    </div>
    <div class="field">
      <label for={`${id}-topic`}>来意 <span class="req">*</span></label>
      <select id={`${id}-topic`} name="topic" required>
        <option value="">请选择</option>
        {TOPICS.map((t) => (
          <option value={t} selected={t === topic}>{t}</option>
        ))}
      </select>
    </div>
  </div>

  <div class="field">
    <label for={`${id}-message`}>留言内容</label>
    <textarea
      id={`${id}-message`}
      name="message"
      rows="4"
      placeholder="品类、规格、数量、用途，或你想索取的检测报告与资质文件；写清这些，报价和回复会更快。"
    ></textarea>
  </div>

  <!-- Honeypot：人看不见，机器会填，填了直接丢弃 -->
  <input
    type="text"
    name="website"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
    style="position:absolute;left:-9999px;top:-9999px"
  />

  <div class="foot">
    <button class="btn primary" type="submit">提交留言</button>
    <span class="tel">或直接拨打 <a href={`tel:${SITE.phone.replace(/-/g, '')}`}>{SITE.phone}</a></span>
  </div>
  <p class="note">留言只用于本次咨询，不做营销推送，也不会提供给第三方。</p>
</form>

<style>
  .inquiry-form { display: grid; gap: 16px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: grid; gap: 6px; align-content: start; }
  .field label { font-size: 13.5px; font-weight: 600; color: #3a3a3a; }
  .req { color: var(--brand); }
  .field input,
  .field select,
  .field textarea {
    font: inherit;
    font-size: 15px;
    padding: 11px 13px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: #fff;
    color: #2b2b2b;
    width: 100%;
  }
  .field textarea { resize: vertical; min-height: 110px; line-height: 1.7; }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(245, 121, 33, .12);
  }
  .hint { margin: -6px 0 0; font-size: 12.5px; color: var(--muted); }
  .foot { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; margin-top: 4px; }
  .foot .btn { border: none; cursor: pointer; font-family: inherit; }
  .tel { font-size: 13.5px; color: var(--muted); }
  .tel a { color: var(--brand-dark); font-weight: 600; }
  .note { margin: 0; font-size: 12.5px; color: var(--muted); line-height: 1.7; }
  @media (max-width: 620px) {
    .row { grid-template-columns: 1fr; }
  }
</style>
