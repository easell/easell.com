---
import { SITE } from '../data/site';
import { CATEGORIES } from '../data/products';
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="container">
    <div class="cols">
      <div>
        <h4>易采通｜{SITE.tagline}</h4>
        <p>致力于「助力塑料污染治理，共建生态循环经济」的一站式集采集供平台。统一监管、统一采购、统一仓储、统一配送，每件产品可溯源。</p>
        <p>湖南易采通供应链有限公司<br />统一社会信用代码：{SITE.uscc}</p>
      </div>
      <div>
        <h4>产品中心</h4>
        <ul>
          {CATEGORIES.map((c) => (
            <li><a href={`/products/${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h4>快速联系</h4>
        <ul>
          <li>服务热线　<a href={`tel:${SITE.phone.replace(/-/g, '')}`}>{SITE.phone}</a></li>
          <li><a href="/contact/#inquiry"><b>在线留言</b></a>（一个工作日内回复）</li>
          <li><a href="/quality/">溯源与品控</a></li>
          <li><a href="/inspection/">核查实录</a></li>
          <li><a href="/news/">行业动态</a></li>
        </ul>
        <p style="margin-top:10px;font-size:12.5px;line-height:1.7;color:#9c8f7d">{SITE.address}</p>
      </div>
    </div>
    <div class="legal">
      <span>© {year} {SITE.legalName} 版权所有</span>
      <span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener nofollow">{SITE.icp}</a>
      </span>
      <span><a href={SITE.groupUrl} target="_blank" rel="noopener">御豪集团</a></span>
    </div>
  </div>
</footer>
