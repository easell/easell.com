---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { SITE } from '../data/site';
---
<BaseLayout
  title="联系我们｜在线留言·采购咨询·经销合作"
  description="联系易采通：在线留言一个工作日内回复，服务热线 0731-88766800。地址：湖南省长沙市岳麓区学士街道碧桂园（智慧园）30 栋 102。支持采购询价与经销合作。"
  breadcrumbs={[{ name: '首页', url: '/' }, { name: '联系我们', url: '/contact/' }]}
  active="/contact/"
>
  <section class="band">
    <div class="container">
      <h1 class="sec">联系易采通</h1>
      <p class="sec-sub">采购询价、政企采购、经销合作，留个言就行——一个工作日内有人回你。</p>

      <div class="contact-cards" style="margin-bottom:36px">
        <div class="card">
          <h3>服务热线</h3>
          <p style="font-size:22px;font-weight:700;color:var(--brand-deep);margin:0">
            <a href={`tel:${SITE.phone.replace(/-/g, '')}`} style="color:inherit;text-decoration:none">{SITE.phone}</a>
          </p>
          <p style="margin-top:6px">{SITE.phoneNote}</p>
        </div>
        <div class="card">
          <h3>公司地址</h3>
          <p>{SITE.address}</p>
        </div>
        <div class="card">
          <h3>在线留言</h3>
          <p>写清品类、数量与用途，一个工作日内回复。</p>
          <p style="margin-top:10px"><a href="#inquiry" class="btn primary" style="padding:9px 20px;font-size:14.5px">填写留言</a></p>
        </div>
      </div>

      <div class="contact-cols">
        <div class="card" style="border-top:4px solid var(--brand)">
          <h2 class="form-h">在线留言</h2>
          <p class="form-sub">带 <span style="color:var(--brand)">*</span> 的是必填项；手机与邮箱至少留一项。</p>
          <InquiryForm id="inquiry" page="/contact/" />
        </div>

        <div>
          <div class="card" style="margin-bottom:20px">
            <h3 style="margin-top:0">怎么联系我们最快</h3>
            <p style="color:var(--muted);line-height:2;font-size:14.5px;margin:0 0 14px">
              要报价、要现货：直接打电话，说明品类、规格、数量，当场给区间。<br />
              要资料、要检测报告、要资质：留言写清要什么，我们把文件发你。
            </p>
            <p style="font-size:24px;font-weight:800;color:var(--brand-deep);margin:0;letter-spacing:.5px">
              <a href={`tel:${SITE.phone.replace(/-/g, '')}`} style="color:inherit;text-decoration:none">{SITE.phone}</a>
            </p>
            <p style="color:var(--muted);font-size:13.5px;margin:6px 0 0">{SITE.phoneNote}</p>
          </div>

          <h3 style="margin:0 0 10px">采购小提示</h3>
          <ul style="color:var(--muted);line-height:2;font-size:14.5px">
            <li>· 咨询时说明品类、规格、数量与用途，报价更快更准</li>
            <li>· 支持「一件起订、一件起发」，小批量也可下单</li>
            <li>· 支持定制规格与 LOGO 印刷，起订量另行沟通</li>
            <li>· 政企客户可提供批量供应方案与合规文件</li>
            <li>· 需要检测报告、标准号、供货资质，可直接索取</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-cols { display: grid; grid-template-columns: 1.15fr .85fr; gap: 32px; align-items: start; }
  .form-h { margin: 0 0 6px; font-size: 19px; }
  .form-sub { margin: 0 0 18px; color: var(--muted); font-size: 13.5px; }
  @media (max-width: 900px) {
    .contact-cols { grid-template-columns: 1fr; }
  }
</style>
