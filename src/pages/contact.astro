---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
---
<BaseLayout
  title="联系我们｜采购咨询·政采服务·经销合作"
  description="联系易采通：7×24 小时服务热线 400-0731-816。支持产品采购询价、政企采购咨询与经销合作。地址：湖南省长沙市岳麓区学士街道学华村碧桂园（智慧园）30 栋 102。"
  breadcrumbs={[{ name: '首页', url: '/' }, { name: '联系我们', url: '/contact/' }]}
  active="/contact/"
>
  <section class="band">
    <div class="container">
      <h1 class="sec">联系易采通</h1>
      <p class="sec-sub">采购询价、政企采购、经销合作，都可以从这里开始。</p>

      <div class="contact-cards" style="margin-bottom:36px">
        <div class="card">
          <h3>服务热线</h3>
          <p style="font-size:22px;font-weight:700;color:var(--brand-deep);margin:0">
            <a href={`tel:${SITE.phone.replace(/-/g, '')}`} style="color:inherit;text-decoration:none">{SITE.phone}</a>
          </p>
          <p style="margin-top:6px">{SITE.phoneNote}</p>
        </div>
        <div class="card">
          <h3>公司地址</h3>
          <p>{SITE.address}</p>
        </div>
        <div class="card">
          <h3>关注公众号</h3>
          <img src="/img/qr-gzh.webp" alt="易采通微信公众号二维码" width="120" height="120" style="width:120px;height:120px" loading="lazy" />
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start">
        <div class="card" style="border-top:4px solid var(--brand)">
          <h3 style="margin-top:0">怎么联系我们最快</h3>
          <p style="color:var(--muted);line-height:2;font-size:14.5px;margin:0 0 16px">
            电话直接接通业务：说明品类、规格、数量、用途，当场给报价区间。<br />
            公众号留言适合先看资料、要检测报告、要报价单。
          </p>
          <p style="font-size:26px;font-weight:800;color:var(--brand-deep);margin:0;letter-spacing:.5px">
            <a href={`tel:${SITE.phone.replace(/-/g, '')}`} style="color:inherit;text-decoration:none">{SITE.phone}</a>
          </p>
          <p style="color:var(--muted);font-size:13.5px;margin:6px 0 18px">{SITE.phoneNote}</p>
          <div style="display:flex;gap:18px;align-items:center;border-top:1px dashed var(--line);padding-top:16px">
            <img src="/img/qr-gzh.webp" alt="易采通微信公众号二维码" width="84" height="84" style="width:84px;height:84px" loading="lazy" />
            <p style="margin:0;font-size:13.5px;color:var(--muted)">
              扫码关注「易采通」公众号<br />
              菜单里有产品目录、检测报告与报价入口<br />
              工作日留言当天回
            </p>
          </div>
        </div>
        <div>
          <h3 style="margin-top:0">采购小提示</h3>
          <ul style="color:var(--muted);line-height:2;font-size:14.5px">
            <li>· 咨询时说明品类、规格、数量与用途，报价更快更准</li>
            <li>· 支持「一件起订、一件起发」，小批量也可下单</li>
            <li>· 支持定制规格与 LOGO 印刷，起订量另行沟通</li>
            <li>· 政企客户可提供批量供应方案与合规文件</li>
            <li>· 需要检测报告、标准号、供货资质，可直接索取</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
