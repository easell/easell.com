---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CATEGORIES } from '../../data/products';
const c = CATEGORIES.find((x) => x.slug === 'cutlery')!;
---
<BaseLayout
  title="可降解刀叉勺、吸管批发｜淀粉基餐具·纸吸管·PLA 吸管"
  description="易采通可降解餐具：玉米淀粉基刀叉勺、纸吸管与 PLA 吸管，单支独立包装、尖口设计，适配奶茶咖啡与快餐，执行 GB/T 18006.3-2020，支持 LOGO 定制。"
  breadcrumbs={[{ name: '首页', url: '/' }, { name: '产品中心', url: '/products/' }, { name: '刀叉勺与吸管', url: '/products/cutlery/' }]}
  active="/products/"
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: '可降解刀叉勺与吸管',
    brand: { '@type': 'Brand', name: '翠上' },
    category: '一次性可降解餐饮具',
    description: c.description,
    image: 'https://www.easell.com' + c.image,
    material: ['玉米淀粉基', '食品级纸', '聚乳酸（PLA）'],
    countryOfOrigin: 'CN',
    additionalProperty: c.standards.map((s) => ({ '@type': 'PropertyValue', name: '执行标准', value: s })),
    manufacturer: { '@type': 'Organization', name: '湖南易采通供应链有限公司', url: 'https://www.easell.com' },
  }}
>
  <section class="band">
    <div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center">
      <div>
        <h1 class="sec">{c.title}</h1>
        <p style="color:var(--muted)">{c.description}</p>
        <div class="stdbar" style="margin-top:18px"><b>执行标准：</b>{c.standards.join('；')}</div>
        <p style="margin-top:18px"><a href="/contact/#inquiry" class="btn primary">获取报价</a></p>
      </div>
      <img src={c.image} alt={c.alt} width="750" height="440" />
    </div>
  </section>

  <section class="band alt">
    <div class="container">
      <h2 class="sec">吸管系列</h2>
      <div class="container" style="display:grid;grid-template-columns:1fr 1fr;gap:36px;align-items:center;padding:0">
        <div>
          <p style="color:var(--muted)">纸吸管与 PLA 吸管双材质可选，单支独立包装，卫生便携；尖口设计方便插杯，适配冷热饮场景。</p>
          <ul style="color:var(--muted);font-size:14.5px">
            {c.notes.map((n) => <li>{n}</li>)}
          </ul>
        </div>
        <img src="/img/cutlery-straw.webp" alt="PLA 吸管单支独立包装" width="750" height="744" loading="lazy" />
      </div>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <h2 class="sec">规格与说明</h2>
      <table class="tbl">
        <tbody>
          {c.specs.map((s) => (
            <tr><th style="width:130px">{s.label}</th><td>{s.value}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="band">
    <div class="container">
      <h2 class="sec">相关产品</h2>
      <p class="sec-sub">同属一次性可降解餐饮具与制品，可合并下单、统一配送。</p>
      <div class="grid grid-4">
        {CATEGORIES.filter((x) => x.slug !== 'cutlery').map((x) => (
          <div class="card">
            <img src={x.image} alt={x.alt} width="800" height="800" loading="lazy" />
            <h3>{x.name}</h3>
            <a class="more" href={`/products/${x.slug}/`}>查看品类 →</a>
          </div>
        ))}
        <div class="card">
          <h3>产品中心</h3>
          <p>查看全部品类与执行标准。</p>
          <a class="more" href="/products/">返回产品中心 →</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
